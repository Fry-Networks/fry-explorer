# PMTiles source for map tiles (currently 404 — replace with working source)
NEXT_PUBLIC_PMTILES_URL=https://pmtiles.heliumfoundation.wtf/world


# Solana RPC
SOLANA_RPC=https://api.mainnet-beta.solana.com

# MongoDB connection (required for /api/hexdata and /api/stats at runtime, NOT required for build)
MONGO_URI=mongodb://user:password@host:27017/dbname?authSource=admin&tls=true

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Dune API key (optional)
DUNE_KEY=

# Local development mode
LOCAL=true

# PostgreSQL for knex migrations (optional — app uses in-memory SQLite fallback)
# DATABASE_URL=postgres://root:@localhost:5432/helium-explorer
