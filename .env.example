# Required: MongoDB connection string for miner data
MONGO_URI=mongodb://localhost:27017/fry-explorer

# Required: Base URL for API calls (your deployed domain or localhost for development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Required: Tile server URL for map visualization
NEXT_PUBLIC_TILES_URL=http://localhost:8080

# Map and external services
NEXT_PUBLIC_PMTILES_URL=https://pmtiles.heliumfoundation.wtf/world
NEXT_PUBLIC_HOTSPOTTY_TILESERVER_URL=https://mt.hotspotty.org
NEXT_PUBLIC_HOTSPOTTY_EXPLORER_API_URL=https://beta-api.hotspotty.net/api/v1/explorer
NEXT_PUBLIC_HOTSPOTTY_EXPLORER_API_TOKEN=your-hotspotty-api-token-here

# Blockchain and analytics
SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_GA_ID=
DUNE_KEY=

# Development settings
LOCAL=true

# Optional: PostgreSQL database URL; if missing, the app will use an in-memory sqlite database
# DATABASE_URL=postgres://root:@localhost:5432/helium-explorer
